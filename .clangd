CompileFlags:
  Add:
    - -std=c++23
    - -Wall
    - -Wextra
    - -Wpedantic
    # - -Weverything  # ほぼすべての警告を有効化
    - -Wunused-variable
    - -Wunused-parameter
    - -Wunused-function
    # - -Wsign-compare
    # - -Wconversion
    - -Wshadow
    - -Wno-keyword-macro
    - -I/lib/ac-library

Index:
  Background: Build

InlayHints:
  Enabled: false

Diagnostics:
  UnusedIncludes: Relaxed
  MissingIncludes: Relaxed
  Suppress:
    - missing-includes
    - Wvla-cxx-extension


