{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "buildForAllTest",
			"command": "g++",
			"args": [
				"-std=gnu++23",
				"-g",
				"${file}",
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"presentation": {
				"reveal": "never"
			},
			"group": "build",
			"detail": "コンパイラ:g++"
		},
		{
			"type": "shell",
			"label": "buildC++",
			"command": "g++",
			"args": [
				"-std=gnu++23",
				"-g",
				"${file}",
				"-o",
				"${fileDirname}/${fileBasenameNoExtension}",
			],
			"options": {
				"cwd": "${fileDirname}"
			},
			"presentation": {
				"reveal": "never"
			},
			"group": "build",
			"detail": "コンパイラ:g++"
		},
		{
			"label": "C++:AllTest",
			"type": "shell",
			"command": "cd",
			"args": [
				"${fileDirname}",
				";",
				"oj",
				"t",
				"-d",
				"${fileDirname}/tests/",
			],
			"dependsOn": [
				"buildForAllTest"
			]
		},
		{
			"label": "removeExeForAllTest",
			"type": "shell",
			"command": "rm",
			"options": {
				"cwd": "${fileDirname}"
			},
			"presentation": {
				"reveal": "never"
			},
			"args": [
				"-r",
				"*.out"
			],
		},
		{
			"label": "removeExe",
			"type": "shell",
			"command": "rm",
			"presentation": {
				"reveal": "never"
			},
			"args": [
				"-r",
				"${fileDirname}/${fileBasenameNoExtension}"
			],
		},
	]
}
