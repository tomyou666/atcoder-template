{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++:Debug",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${fileDirname}",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "buildC++",
            "postDebugTask": "removeExe",
            "args": []
        },
        {
            "name": "C++:AllTest",
            "type": "cppdbg",
            "request": "launch",
            "cwd": "${fileDirname}",
            "preLaunchTask": "buildForAllTest",
            "postDebugTask": "removeExeForAllTest",
            "program": "/bin/zsh",
            "args": [
                "-c",
                "\"oj t -d ${fileDirname}/tests/\"",
            ],
        },
    ]
}
